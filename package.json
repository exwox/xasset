{
  "name": "xasset",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-cesium-assets.mjs",
    "predev": "node scripts/copy-cesium-assets.mjs",
    "prebuild": "node scripts/copy-cesium-assets.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/server/database.integration.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "import:assets": "tsx scripts/import-assets.ts",
    "worker": "tsx src/worker/dxf-worker.ts",
    "validate:dxf": "tsx scripts/validate-dxf.ts",
    "sync:dxf-colors": "tsx scripts/sync-dxf-layer-colors.ts",
    "smoke:deployment": "tsx scripts/deployment-smoke.ts",
    "smoke:e2e": "tsx scripts/e2e-critical-flow.ts",
    "smoke:all": "bash scripts/docker-smoke.sh",
    "test:load": "tsx scripts/load-test.ts",
    "test:security": "tsx scripts/security-smoke.ts",
    "reconcile:assets": "tsx scripts/reconcile-assets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/s3-request-presigner": "^3.1110.0",
    "@cesium/engine": "^18.0.0",
    "@cesium/widgets": "^13.0.0",
    "@zip.js/zip.js": "2.7.73",
    "bullmq": "^6.1.1",
    "dxf-parser": "^1.1.2",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "leaflet": "^1.9.4",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
